# VT Code Configuration File (Example)
# Copy this file to vtcode.toml and keep only the overrides you need.
# This example is intentionally sparse. Defaults are omitted on purpose.

# Feature flags (Codex-compatible)
[features]
# Master toggle for the memories subsystem. When true, VT Code extracts
# durable context from completed threads and injects it into future sessions.
memories = true

[agent]
# Replace these values for your provider and API key environment variable.
provider = "ollama"
api_key_env = "OLLAMA_API_KEY"
default_model = "gpt-oss:120b-cloud"
reasoning_effort = "low"

# Example OpenAI-compatible custom provider (Atlas Cloud):
# provider = "atlascloud"
# default_model = "deepseek-ai/deepseek-v4-flash"
#
# [[custom_providers]]
# name = "atlascloud"
# display_name = "Atlas Cloud"
# base_url = "https://api.atlascloud.ai/v1"
# api_key_env = "ATLASCLOUD_API_KEY"
# model = "deepseek-ai/deepseek-v4-flash"
# context_window = 256000   # provider capability in tokens
# api_format = "auto"       # hint: auto|openai-chat|openai-responses|anthropic-messages
# Optional provider-level conservative defaults (applied when model metadata is missing):
# supports_tools = true
# supports_vision = false
# Per-model sparse profiles do NOT enable models; they only override runtime defaults:
# # [custom_providers.profiles."deepseek-ai/deepseek-v4-flash"]
# # api_format = "openai-responses"
# # context_window = 262144
# # supports_tools = true
# # supports_structured_output = true
#
# models = [
#     "deepseek-ai/deepseek-v4-flash",
#     "deepseek-ai/DeepSeek-V3-0324",
#     "moonshotai/kimi-k2.7-code",
#     "moonshotai/kimi-k2.6",
#     "zai-org/glm-5.2",
#     "zai-org/glm-4.7",
#     "minimaxai/minimax-m3",
#     "minimaxai/minimax-m2.1",
# ]

[agent.persistent_memory]
enabled = true

# Codex-compatible memories sub-configuration
[agent.persistent_memory.memories]
generate_memories = true
use_memories = true
# extract_model = "gpt-6-luna"
# consolidation_model = "gpt-6-luna"

[telemetry]
atif_enabled = true
bottleneck_tracing = false

[ui]
# Application icon artwork: "dynamic" follows the active light/dark mode,
# "light", "dark", "clear", and "tinted" pin one variant.
# app_icon = "dynamic"
# When omitted, reduced motion uses VTCODE_REDUCE_MOTION first, then a supported
# OS accessibility preference (Windows, macOS, GNOME/KDE/XFCE on Linux).
# Explicit true or false always wins.
# reduce_motion_mode = true
# How plain Enter submits while a turn is running: "queue" (default) holds
# each message for the next turn; "steer" injects plain-text input into the
# live turn. Slash commands and attachments always queue.
# busy_enter_behavior = "queue"

[ui.terminal_title]
items = ["project", "spinner", "app-name", "git-branch"]

[tools.policies]
# Add only the overrides you want to differ from defaults.
start_planning = "prompt"
request_user_input = "allow"
task_tracker = "prompt"
exec_command = "prompt"
write_stdin = "prompt"
apply_patch = "prompt"
code_search = "allow"

# Optional OpenAI Responses minimum cache lifetime (30m by default).
# 12h writes cost 2.5x ordinary input; 30m writes cost 1.25x.
[prompt_cache.providers.openai]
# prompt_cache_ttl = "12h"

# Timeouts. Every value is in seconds; 0 disables that limit.
# The defaults suit a fast, warm connection. Raise them if you are on a slow or
# high-latency link, a large repository, or a cold model/server start -- those
# are slow, not broken. Edits apply without restarting the session.
[timeouts]
# Tool ceilings by category.
default_ceiling_seconds = 180
pty_ceiling_seconds = 300
mcp_ceiling_seconds = 120
streaming_ceiling_seconds = 600
long_running_command_ceiling_seconds = 3600
# Outbound HTTP defaults for every network client. These also read
# VTCODE_HTTP_CONNECT_TIMEOUT_SECS / VTCODE_HTTP_REQUEST_TIMEOUT_SECS /
# VTCODE_HTTP_DOWNLOAD_TIMEOUT_SECS when the key below is absent.
http_connect_seconds = 5
http_request_seconds = 30
http_download_seconds = 300
