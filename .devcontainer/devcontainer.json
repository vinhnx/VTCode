// Contributor dev container: an isolated sandbox for opening (possibly
// untrusted) checkouts. The base image tracks the same pinned toolchain as
// the builder stage in Dockerfile.build; keep both digests in sync when the
// toolchain pin moves (manual step in docs/development/toolchain-updates.md).
{
	"name": "VT Code",
	"image": "rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37",
	// System dependencies mirror the builder stage in Dockerfile.build.
	"postCreateCommand": "apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends build-essential git libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*",
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer"
			]
		}
	}
}
