# Multi-stage Dockerfile for building vtcode with sufficient memory and resources.
# This is a contributor build image, not a shipped runtime: releases ship
# prebuilt binaries (see scripts/release.sh), not containers. Base images are
# pinned by digest for reproducible builds; refresh with `docker buildx
# imagetools inspect <tag>` when the toolchain pin moves (checked by
# scripts/check_compatibility.sh, which reads the tag, not the digest).
FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS builder

# Install required system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy the entire project
COPY . .

# Configure cargo to use less memory during compilation
# by reducing parallel jobs and disabling incremental compilation
ENV CARGO_BUILD_JOBS=2
ENV CARGO_INCREMENTAL=0
ENV RUSTC_WRAPPER=
ENV SCCACHE_DIR=
ENV SCCACHE_CACHE_SIZE=

# Build the project with release profile (more memory efficient than dev with LTO)
# Use --release to get optimized binary without the aggressive dev LTO settings
RUN cargo build --release

# Verify the binary was created
RUN test -f /build/target/release/vtcode

# Optional: Create a minimal runtime image
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy the built binary from builder stage
COPY --from=builder --chmod=755 /build/target/release/vtcode /usr/local/bin/vtcode

# Run as an unprivileged user: nothing in this image needs root. The home
# directory is created (not /nonexistent) because interactive vtcode sessions
# write config/state under $HOME.
RUN groupadd -r vtcode && useradd -r -m -g vtcode -d /home/vtcode -s /usr/sbin/nologin vtcode
USER vtcode

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/vtcode"]
CMD ["--help"]
